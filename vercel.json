{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "env": {
    "PROJECT_NAME": "Mailguard",
    "ENVIRONMENT": "production",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "120"
  }
}
